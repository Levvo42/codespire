{
  "name": "codespire",
  "compatibility_date": "2026-10-01",
  "main": "server/index.js",
  "assets": { "directory": "./dist" },
  "d1_databases": [
    {
      "binding": "codespire_db",
      "database_name": "codespire-db",
      "database_id": "8f6ebdef-d29d-49a9-9b74-d21e46f8bc54",
      // The preview database again, so `--preview` in d1 commands targets it
      "preview_database_id": "748e6f8e-2a09-4dbc-8d55-55d34e4e3281",
    },
  ],
  // Used by pull request preview deployments instead of the live database
  "previews": {
    "d1_databases": [
      {
        "binding": "codespire_db",
        "database_name": "codespire-db-preview",
        "database_id": "748e6f8e-2a09-4dbc-8d55-55d34e4e3281",
      },
    ],
  },
}
