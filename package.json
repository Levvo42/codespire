{
  "name": "codespire",
  "version": "1.0.0",
  "private": true,
  "description": "Coding Trivia RPG built with HTML, SCSS, JavaScript and Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/**/*.scss\" --fix",
    "lint:html": "html-validate index.html pages",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "check": "npm run format:check && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Levvo42/codespire.git"
  },
  "keywords": [],
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Levvo42/codespire/issues"
  },
  "homepage": "https://github.com/Levvo42/codespire#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "html-validate": "^11.16.0",
    "prettier": "3.9.9",
    "sass": "^1.104.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  },
  "dependencies": {
    "modern-normalize": "^3.0.1"
  }
}
