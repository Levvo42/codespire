# Installed dependencies — restored by running `npm install`
node_modules/

# Production build output — generated by `npm run build`
dist/

# Local environment variables (API keys etc.) — never commit these.
# Copy .env.example to .env and fill in your own values.
.env
.env.*
# ...but DO commit the template that shows which variables are needed
!.env.example

# Editor and OS junk
.idea/
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json